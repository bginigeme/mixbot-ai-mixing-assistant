# MixBot environment variables
# Copy this file to .env and fill in your values — never commit .env to git.

# Anthropic API key — required for Claude AI feedback and chat
# Get yours at https://console.anthropic.com/
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ── MCP Server (Cursor / Claude Desktop) ────────────────────────────────────
# To use the MixBot MCP server in Cursor, add this to your MCP settings
# (Settings → MCP → Edit config):
#
# {
#   "mcpServers": {
#     "mixbot": {
#       "command": "/Users/YOU/mixbot/mcp_env/bin/python",
#       "args": ["/Users/YOU/mixbot/mcp_server.py"]
#     }
#   }
# }
#
# Replace /Users/YOU/mixbot with your actual project path.
